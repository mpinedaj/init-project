# ============================================
# Konta — Variables de entorno
# Copia este archivo a `.env` y completa los valores.
# ============================================

# ---- Vite ----
# Modo de ejecución (development, production, test)
VITE_APP_ENV=development

# URL base de la aplicación (usada para enlaces y analytics)
VITE_APP_URL=http://localhost:5173

# ---- Supabase (autenticación y base de datos) ----
# Obtén estos valores en: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Opcional: analítica / error tracking ----
# VITE_SENTRY_DSN=